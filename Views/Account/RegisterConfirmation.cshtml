@{
    ViewData["Title"] = "Xác thực email";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3">Kiểm tra email</h1>
                <p>
                    Hướng dẫn xác thực tài khoản đã được gửi
                    @if (TempData["RegisterEmail"] is string email)
                    {
                        <strong>@email</strong>
                    }
                    nếu địa chỉ email hợp lệ.
                </p>
                @if (TempData["EmailDeliveryError"] is string error)
                {
                    <div class="alert alert-warning" role="alert">@error</div>
                }
                <a asp-action="ResendConfirmation">Gửi lại email xác thực</a>
            </div>
        </div>
    </div>
</div>
