@{
    ViewData["Title"] = "Kiểm tra email";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-6">
        <div class="alert alert-info" role="status">
            Nếu email tồn tại và đã xác thực, hướng dẫn đặt lại mật khẩu sẽ được gửi đến hộp thư.
        </div>
        @if (TempData["EmailDeliveryError"] is string error)
        {
            <div class="alert alert-warning" role="alert">@error</div>
        }
    </div>
</div>
