@model DemoMVC.Models.Product

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">Thêm sản phẩm</h2>
                </div>
                
                <hr>
                <form asp-action="Upload" enctype="multipart/form-data">
                    <div class="row form-control mx-0">
                        <label class="col-sm-4 col-form-label">Import data from Excel: </label>
                        <div class="col-sm-5">
                            <input type="file" name="file" class="form-control">
                        </div>
                        <div class="col-sm-3">
                            <input type="submit" value="Upload" class="btn btn-primary w-100">
                        </div>
                    </div>
                </form>
                <hr />

                <div class="card-body p-4">

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- 1. Mã sản phẩm tự động sinh (chỉ hiển thị, không cho sửa) -->
                        <div class="mb-3">
                            <label asp-for="ProductId" class="form-label fw-bold">
                                Mã sản phẩm (Tự động)
                            </label>

                            <input asp-for="ProductId"
                                   class="form-control bg-light"
                                   readonly />

                            <span asp-validation-for="ProductId"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- 2. Tên sản phẩm -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">
                                Tên sản phẩm
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Nhập tên sản phẩm" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- 3. Giá -->
                        <div class="mb-3">
                            <label asp-for="Price" class="form-label fw-bold">
                                Giá
                            </label>

                            <input asp-for="Price"
                                   class="form-control"
                                   placeholder="Nhập giá sản phẩm" />

                            <span asp-validation-for="Price"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- 4. Số lượng -->
                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label fw-bold">
                                Số lượng
                            </label>

                            <input asp-for="Quantity"
                                   class="form-control"
                                   placeholder="Nhập số lượng sản phẩm" />

                            <span asp-validation-for="Quantity"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- 5. Danh mục sản phẩm (Khóa ngoại) -->
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label fw-bold">
                                Danh mục sản phẩm
                            </label>

                            <select asp-for="CategoryId"
                                    class="form-select"
                                    asp-items="ViewBag.CategoryId">
                                <option value="">-- Chọn danh mục --</option>
                            </select>

                            <span asp-validation-for="CategoryId"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mt-4">
                            <button type="submit"
                                    class="btn btn-primary">
                                <i class="bi bi-save"></i>
                                Lưu sản phẩm
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Quay lại
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}