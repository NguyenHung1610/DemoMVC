@model DemoMVC.Models.PagedResult<DemoMVC.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
    var firstPage = Math.Max(1, Model.Page - 2);
    var lastPage = Math.Min(Model.TotalPages, Model.Page + 2);
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Quản lý sản phẩm</h2>
            <p class="text-muted mb-0">Danh sách thiết bị điện</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Thêm sản phẩm
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            <strong>Thành công!</strong>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-6">
            <label for="product-search" class="form-label">Tìm kiếm sản phẩm</label>
            <input id="product-search"
                   name="search"
                   value="@Model.SearchTerm"
                   class="form-control"
                   placeholder="Mã, tên sản phẩm hoặc danh mục" />
        </div>
        <div class="col-6 col-md-2">
            <label for="product-page-size" class="form-label">Số dòng</label>
            <select id="product-page-size" name="pageSize" class="form-select" onchange="this.form.submit()">
                @foreach (var size in new[] { 10, 20, 50 })
                {
                    <option value="@size" selected="@(Model.PageSize == size ? "selected" : null)">@size</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-auto d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
        </div>
    </form>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center">Mã sản phẩm</th>
                            <th>Tên sản phẩm</th>
                            <th>Giá</th>
                            <th>Danh mục</th>
                            <th class="text-center">Chức năng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count > 0)
                        {
                            @foreach (var product in Model.Items)
                            {
                                <tr>
                                    <td class="text-center fw-bold text-primary">@product.ProductId</td>
                                    <td><strong>@product.Name</strong></td>
                                    <td>
                                        <span class="text-danger fw-bold">
                                            @($"{product.Price:N0}") VND
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@product.Category?.CategoryName</span>
                                    </td>
                                    <td class="text-center text-nowrap">
                                        <a asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-info btn-sm text-white">Chi tiết</a>
                                        <a asp-action="Edit" asp-route-id="@product.ProductId" class="btn btn-warning btn-sm">Sửa</a>
                                        <a asp-action="Delete" asp-route-id="@product.ProductId" class="btn btn-danger btn-sm">Xóa</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    Không tìm thấy sản phẩm phù hợp.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
        <span class="text-muted">
            @if (Model.TotalCount == 0)
            {
                <text>Tổng số 0 sản phẩm</text>
            }
            else
            {
                var firstItem = (Model.Page - 1) * Model.PageSize + 1;
                var lastItem = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
                <text>Hiển thị @firstItem–@lastItem trong tổng số @Model.TotalCount sản phẩm</text>
            }
        </span>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Phân trang sản phẩm">
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@Model.SearchTerm"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-pageSize="@Model.PageSize"
                           aria-label="Trang trước">Trước</a>
                    </li>
                    @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@Model.SearchTerm"
                               asp-route-page="@pageNumber"
                               asp-route-pageSize="@Model.PageSize"
                               aria-current="@(pageNumber == Model.Page ? "page" : null)">@pageNumber</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@Model.SearchTerm"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-pageSize="@Model.PageSize"
                           aria-label="Trang sau">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
