@model DemoMVC.Models.Student

<dl class="row mb-0">
    <dt class="col-sm-4">Mã sinh viên</dt>
    <dd class="col-sm-8">@Model.StudentCode</dd>
    <dt class="col-sm-4">Họ và tên</dt>
    <dd class="col-sm-8">@Model.FullName</dd>
    <dt class="col-sm-4">Email</dt>
    <dd class="col-sm-8">@Model.Email</dd>
    <dt class="col-sm-4">Địa chỉ</dt>
    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Address) ? "Chưa cập nhật" : Model.Address)</dd>
    <dt class="col-sm-4">Khoa</dt>
    <dd class="col-sm-8">@Model.Department?.Name</dd>
    <dt class="col-sm-4">Năm nhập học</dt>
    <dd class="col-sm-8">@Model.AdmissionYear</dd>
</dl>
<div class="d-flex justify-content-end mt-3">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
</div>
